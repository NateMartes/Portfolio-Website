---
import DistroLogo from "@/components/logos/distro-logo.astro";
import SectionTitle from "@/components/section-title.astro";
import Experience from "@/components/tui/experience.astro";
import Lazygit from "@/components/tui/lazygit/index.astro";
import Mutt from "@/components/tui/mutt/index.astro";
import Ranger from "@/components/tui/ranger/index.astro";
import config from "@/config.json";
import Layout from "@/layouts/default.astro";

const { current, site, systems: distros } = config;
type System = (typeof distros)[number];

/** `perDistro` marca las filas cuyo valor cambia con la distro activa */
const info: {
  k: string;
  v?: string;
  perDistro?: (system: System) => string;
}[] = [
  { k: "OS", perDistro: (s) => s.os },
  { k: "Host", v: current.host },
  { k: "Shell", v: "bash" },
  { k: "Name", v: "Nathaniel Martes" },
];

const metadata = [
  "Software Engineer",
  "DevOps and Automation",
  "Distributed Systems",
  "Martial Arts",
  "Open Source",
];
---

<Layout
  title={site.title}
  description={site.description}
>
  <div class="mb-10 flex flex-col items-start md:flex-row gap-6 md:gap-12">
    <DistroLogo />
    <div class="min-w-0 w-full">
      <div class="font-medium text-accent mb-1.5">
        <h1 class="inline border-b border-dim pb-0.5">
          {site.author}
          {site.handle_suffix && (<><span class="text-dim">@</span>{site.handle_suffix}</>)}
        </h1>
      </div>

      {info.map(({ k, v, perDistro }) => (
        <div class="mb-[0.05rem] flex items-center gap-2">
          <span class="inline-block font-medium text-accent min-w-22.5">{k}</span>
          {perDistro ? (
            distros.map((distro) => (
              <span data-distro={distro.slug}>{perDistro(distro)}</span>
            ))
          ) : (
            <span>{v}</span>
          )}
        </div>
      ))}
      <div class="mt-4">
        <h2 class="font-medium text-accent mb-2">Metadata:</h2>
        <pre class="whitespace-pre-wrap break-words text-xs leading-relaxed text-dim"><code>{'<?xml version="1.0" encoding="UTF-8"?>\n<metadata>\n'}{metadata.map((item) => (<>{'  <metadata-item>'}<span class="text-accent">{item}</span>{'</metadata-item>\n'}</>))}{'</metadata>'}</code></pre>
      </div>
      <nav aria-label="Page sections" class="mt-4 flex flex-col items-start gap-2 border-t border-border pt-3">
        {["about", "experience", "projects", "contact"].map((section) => (
          <a
            href={`#${section}`}
            class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
          >
            <span aria-hidden="true" class="text-dim">./</span>{section}
          </a>
        ))}
        <a href="/blogs" class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
          <span aria-hidden="true" class="text-dim">./</span>blogs
        </a>
      </nav>
    </div>
  </div>

  <section id="about" class="my-10 scroll-mt-6">
    <SectionTitle title="about" />
    <Lazygit />
  </section>

  <section id="experience" class="my-10 scroll-mt-6">
    <SectionTitle title="experience" />
    <Experience />
  </section>

  <section id="projects" class="my-10 scroll-mt-6">
    <SectionTitle title="projects" />
    <Ranger />
  </section>

  <section id="contact" class="my-10 scroll-mt-6">
    <SectionTitle title="contact" />
    <Mutt />
  </section>
</Layout>
