---
import config from "@/config.json";

const { command, jobs } = config.sections.experience;
---

<p class="mb-6 text-sm leading-relaxed text-dim">
  <span aria-hidden="true" class="text-accent">$ </span><code>{command}</code>
</p>
<div class="border-l border-border pl-4 sm:pl-6">
  {jobs.map((job) => (
    <article class="mb-8 last:mb-0">
      <header class="mb-3">
        <h3 class="text-base font-medium text-accent">{job.role}</h3>
        <p class="mt-1">
          <a href={job.companyUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-accent/40 underline-offset-4 hover:text-accent hover:decoration-accent focus-visible:outline-2 focus-visible:outline-accent focus-visible:outline-offset-4">@ {job.company}</a>
        </p>
        <p class="mt-1 text-sm text-dim">
          {job.startDate === "Coming" && job.endDate === "Soon"
            ? "Coming Soon"
            : `${job.startDate} — ${job.endDate}`}
        </p>
      </header>
      <div class="space-y-2 text-sm leading-relaxed">
        {job.description.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      {job.tech.length > 0 && (
        <ul aria-label="Skills and technologies" class="mt-3 flex flex-wrap gap-2">
          {job.tech.map((skill) => (
            <li class="border border-border bg-panel px-2 py-0.5 text-sm text-accent">{skill}</li>
          ))}
        </ul>
      )}
    </article>
  ))}
</div>
